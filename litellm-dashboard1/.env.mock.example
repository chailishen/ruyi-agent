# litellm-dashboard1 — 高保真原型（Mock）模式
# cp .env.mock.example .env.local

NEXT_PUBLIC_MOCK_MODE=true

# 原型模式勿指向 Proxy :4000（留空即可，API 走 MSW 相对路径）
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_MOCK_DEFAULT_ROLE=proxy_admin
NEXT_PUBLIC_MOCK_LATENCY_MS_MIN=200
NEXT_PUBLIC_MOCK_LATENCY_MS_MAX=600

# 可选：对比 monorepo 内真实 Proxy
# NEXT_PUBLIC_MOCK_MODE=false
# NEXT_PUBLIC_PROXY_URL=http://localhost:4000
