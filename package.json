{
  "name": "xailab-manual-capture",
  "version": "0.1.0",
  "private": true,
  "description": "URL full-page screenshot service powered by Playwright.",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "capture": "node src/cli.js https://xailab.com.cn/ --output=output/xailab.png",
    "capture:desktop": "node src/cli.js https://xailab.com.cn/ --output=output/xailab-desktop.png --width=1440 --height=900",
    "capture:mobile": "node src/cli.js https://xailab.com.cn/ --output=output/xailab-mobile.png --width=390 --height=844",
    "check": "node --check src/security.js && node --check src/screenshot.js && node --check src/cli.js && node --check src/server.js",
    "screenshot": "node src/cli.js",
    "screenshot:server": "node src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "playwright": "^1.53.0",
    "sharp": "^0.34.5"
  }
}
