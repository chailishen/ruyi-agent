# AgentOS 00 一体机 PostgreSQL（经 SSH 隧道）
# 复制为 .env 后填写真实密码：cp .env.example .env

PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=agentos_bff
PGUSER=agentos
PGPASSWORD=请替换为业务账号密码
PGSSLMODE=disable

# SSH 隧道（与 scripts/tunnel.sh 一致）
SSH_KEY=~/.ssh/agentos-prod
SSH_PROXY_HOST=agentos-prod
SSH_JUMP_LOCAL=127.0.0.1
SSH_JUMP_PORT=6022
SSH_REMOTE_USER=ubuntu
SSH_REMOTE_HOST=127.0.0.1
SSH_HOST_KEY_ALIAS=ws00-frp-audit
# 数据库容器 IP；重建后可能变化
PG_CONTAINER_IP=172.23.0.6
PG_CONTAINER_PORT=5432
LOCAL_BIND=127.0.0.1:15432
