# 复制为 config.env 后填写（config.env 已加入 .gitignore）

# OpenAPI 网关根地址，不要末尾斜杠
# 测试环境示例（以 meta.json / 运维提供为准）：
#   https://zhxz-test.xasp.com.cn/papi/openapi
#   或内网 http://192.168.70.7:10600/papi/openapi
E10_OPENAPI_ORIGIN=https://zhxz-test.xasp.com.cn/papi/openapi

# 开放平台开发者资料
E10_CORPID=
E10_APP_KEY=
E10_APP_SECRET=

# 以谁的身份查流程（OpenAPI 用户 ID，非 HRM id）
E10_USERID=

# 可选：直接注入已有令牌（跳过 auth code 流程，调试用）
# E10_ACCESS_TOKEN=
# E10_REFRESH_TOKEN=
