": \"Main_Receiver_Department\",\n            \"fieldName\": \"主送单位\",\n            \"fieldDesc\": \"公文的主要受理机关。应使用主送机关的全称规范化简称或者同类型机关的统称\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886023\",\n            \"fieldType\": 22,\n            \"fieldCode\": \"Copy_to_Department\",\n            \"fieldName\": \"抄送单位\",\n            \"fieldDesc\": \"除主送机关外需要执行或者知晓公文内容的其他机关\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886024\",\n            \"fieldType\": 23,\n            \"fieldCode\": \"Printing_and_Sending_Department\",\n            \"fieldName\": \"印发单位\",\n            \"fieldDesc\": \"公文的送印机关，一般是各机关的办公厅（室）或文秘部门\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886025\",\n            \"fieldType\": 101,\n            \"fieldCode\": \"Issuer_Department\",\n            \"fieldName\": \"发文单位\",\n            \"fieldDesc\": \"发文机关全称或者规范化简称，其后添加特定标志\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886026\",\n            \"fieldType\": 102,\n            \"fieldCode\": \"Signer\",\n            \"fieldName\": \"签发人\",\n            \"fieldDesc\": \"签发公文人员的姓名\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886027\",\n            \"fieldType\": 103,\n            \"fieldCode\": \"Document_Type\",\n            \"fieldName\": \"文种\",\n            \"fieldDesc\": \"公文的种类\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886028\",\n            \"fieldType\": 0,\n            \"fieldCode\": \"Serial_Number_of_Copies\",\n            \"fieldName\": \"份号\",\n            \"fieldDesc\": \"公文印刷份数的顺序号\",\n            \"isOpen\": 1\n        },\n        {\n            \"id\": \"802550412172886029\",\n            \"fieldType\": 0,\n            \"fieldCode\": \"Security_Classification_And_Durationasdasdas\",\n            \"fieldName\": \"密级和保密期限\",\n            \"fi