      "content": [
        {
          "type": "text",
          "text": "package com.weaver.core.demo.select;\n\nimport cn.hutool.http.HttpRequest;\nimport cn.hutool.json.JSONUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\nimport com.weaver.core.demo.DemoBase;\n\n/**\n * 获取节点上下文数据\n *\n * @author:chenwh\n */\npublic class GetNodeContextInfoDemo extends DemoBase {\n\n    public static void main(String[] args) {\n\n        String response = new GetNodeContextInfoDemo().getNodeContextInfo(TOKEN, 959439511657390081L);\n        System.out.println(response);\n    }\n\n    /**\n     * 获取节点上下文数据\n     *\n     * @param token\n     * @param requestId\n     * @return\n     */\n    public String getNodeContextInfo(String token, long requestId) {\n        String url = HOST + \"/api/workflow/core/paService/v1/getNodeContextInfo?access_token=\" + token;\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"requestId\", requestId);\n        param.put(\"userCurrentNodeId\", TestConstant.WORKFLOW_YBLC_NODE);\n\n        // 发送请求\n        return HttpRequest.post(url)\n                .header(\"Content-Type\", \"application/json\")\n                .body(JSONUtil.toJsonStr(param))\n                .execute()\n                .body();\n    }\n}"
        }
      ]
    },
