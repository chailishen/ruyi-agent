          "type": "text",
          "text": "package com.weaver.core.demo;\n\nimport cn.hutool.http.HttpRequest;\nimport cn.hutool.json.JSONUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\nimport com.weaver.core.utils.RequestUtil;\n\n/**\n * 批量提交\n */\npublic class BatchSubmitDemo extends DemoBase {\n\n    public static void main(String[] args) {\n        String response = new BatchSubmitDemo().batchSubmit();\n        System.out.println(response);\n    }\n\n    /**\n     * 批量提交\n     * {\"message\":{\"errcode\":\"0\",\"errmsg\":\"success\",\"otherData\":{}},\"data\":{\"successRequest\":[],\"isAsync\":true,\"failRequest\":{}}}\n     * {\"message\":{\"errcode\":\"0\",\"errmsg\":\"success\",\"otherData\":{}},\"data\":{\"successRequest\":[\"959474781853327360\",\"959474876288966657\"],\"isAsync\":false,\"failRequest\":{}}}\n     *\n     * @return\n     */\n    public String batchSubmit() {\n        String url = HOST + \"/api/workflow/core/paService/v1/batchSubmit?access_token=\" + TOKEN;\n\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"remark\", \"批量提交\");\n        param.put(\"isAsync\", false);\n        param.put(\"requestIds\", \"959474781853327360,959474876288966657\");\n\n        return HttpRequest.post(url)\n                .header(\"Content-Type\", \"application/json\")\n                // 参数放入body\n                .body(JSONUtil.toJsonStr(param))\n                .execute()\n                .body();\n    }\n}\n"
        }
