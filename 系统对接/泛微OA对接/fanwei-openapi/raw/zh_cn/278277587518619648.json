      "content": [
        {
          "type": "text",
          "text": "package com.weaver.core.demo;\n\nimport cn.hutool.http.HttpRequest;\nimport cn.hutool.json.JSONUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\n\n/**\n * 委托收回\n *\n * @author:chenwh\n */\npublic class RecoverAgentDemo extends DemoBase {\n    public static void main(String[] args) {\n        String response = new RecoverAgentDemo().recoverAgent();\n        System.out.println(response);\n    }\n\n    /**\n     * 委托收回\n     * {\"message\":{\"errcode\":\"200\",\"errmsg\":\"接口返回成功\",\"otherData\":{}},\"data\":{\"access_token\":\"ef282f98fb0cec759c88cde8dca0032f\",\"beAgentUserId\":5116374622026176523,\"userid\":5116374622026176523,\"agentUserId\":763199432279900161,\"agentIds\":\"959476254980808713\"}}\n     *\n     * @return\n     */\n    public String recoverAgent() {\n        String url = HOST + \"/api/workflow/core/paService/v1/recoverAgent?access_token=\" + TOKEN;\n\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"agentUserId\", TestConstant.USER_ZMM);\n        param.put(\"beAgentUserId\", TestConstant.USER_CHENWH);\n\n        return HttpRequest.post(url)\n                .header(\"Content-Type\", \"application/json\")\n                // 参数放入body\n                .body(JSONUtil.toJsonStr(param))\n                .execute()\n                .body();\n    }\n}"
        }
      ]
