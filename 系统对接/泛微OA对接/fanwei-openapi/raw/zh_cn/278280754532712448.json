          "type": "text",
          "text": "package com.weaver.core.demo;\n\nimport cn.hutool.http.HttpRequest;\nimport cn.hutool.json.JSONUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\n\n/**\n * 强制结束\n */\npublic class DoForceOverDemo extends DemoBase {\n    public static void main(String[] args) {\n        String response = new DoForceOverDemo().doForceOver(959474781853327360L);\n        System.out.println(response);\n    }\n\n    /**\n     * 强制归档\n     * {\"message\":{\"errcode\":\"0\",\"errmsg\":\"流程提交成功读取后端配置\",\"requestId\":\"959474781853327360\",\"otherData\":{}}}\n     *\n     * @return\n     */\n    public String doForceOver(long requestId) {\n        String url = HOST + \"/api/workflow/core/paService/v1/doForceOver?access_token=\" + TOKEN;\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"requestId\", requestId);\n        // 1：以监控权限强制结束；\n        param.put(\"ismonitor\", 1);\n\n        // 发送请求\n        return HttpRequest.post(url)\n                .header(\"Content-Type\", \"application/json\")\n                .body(JSONUtil.toJsonStr(param))\n                .execute()\n                .body();\n    }\n}"
        }
