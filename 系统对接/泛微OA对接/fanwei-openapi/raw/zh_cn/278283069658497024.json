          "text": "package com.weaver.core.demo;\n\nimport cn.hutool.http.HttpRequest;\nimport cn.hutool.json.JSONUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\n\n/**\n * 提交流程给发送人\n *\n * @author:chenwh\n */\npublic class SubmitToSenderDemo extends DemoBase {\n\n    public static void main(String[] args) {\n        String response = new SubmitToSenderDemo().submitToSender(959502823746453508L);\n        System.out.println(response);\n    }\n\n    /**\n     * 提交流程给发送人\n     *\n     * @param requestId\n     * @return\n     */\n    public String submitToSender(long requestId) {\n        String url = HOST + \"/api/workflow/core/paService/v1/submitToSender?access_token=\" + TOKEN;\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"requestId\", requestId);\n        param.put(\"remark\", \"提交给发送人\");\n\n        // 发送请求\n        return HttpRequest.post(url)\n                .header(\"Content-Type\", \"application/json\")\n                .body(JSONUtil.toJsonStr(param))\n                .execute()\n                .body();\n    }\n}"
