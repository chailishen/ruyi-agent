          "type": "text",
          "text": "package com.weaver.core.demo.select;\n\nimport cn.hutool.http.HttpRequest;\nimport com.alibaba.fastjson.JSONObject;\nimport com.weaver.core.constant.TestConstant;\nimport com.weaver.core.demo.DemoBase;\n\n/**\n * 批量获取流程基础信息\n *\n * @author:chenwh\n * @date:2024/5/31 14:34\n */\npublic class BatchGetRequestInfoDemo extends DemoBase {\n    public static void main(String[] args) {\n        String response = new BatchGetRequestInfoDemo().batchGetRequestInfo();\n        System.out.println(response);\n    }\n\n    /**\n     * 批量获取流程基础信息\n     *\n     * @return\n     */\n    public String batchGetRequestInfo() {\n        String url = HOST + \"/api/workflow/core/paService/v1/batchGetRequestInfo?access_token=\" + TOKEN;\n        JSONObject param = new JSONObject();\n        param.put(\"userid\", TestConstant.USER_CHENWH);\n        param.put(\"requestIds\", \"954203366670901251,954214984582316036,954213824785063939,954214095423422472\");\n\n        // 发送请求\n        return HttpRequest.get(url)\n                .form(param)\n                .execute()\n                .body();\n    }\n}"
