          "text": "/**\n     * 字段id，必须封装\n     * 表单字段的唯一标识\n     */\n    @JsonSerialize(using = ToStringSerializer.class)\n    private Long id;\n\n    /**\n     * 字段名称，必须封装\n     */\n    private String name;\n\n    /**\n     * 字段显示名（封存），非必须封装\n     */\n    private String fieldLabel;\n\n    /**\n     * 原始字段类型（单级），必须封装\n     * 该属性记录原始表单字段类型，保留以备特殊场景下使用\n     */\n    private String fieldType;\n\n    /**\n     * 原始字段类型（多级），必须封装\n     * 特殊说明：当字段没有类型的多级划分时，fieldType = nativeType\n     * 若字段存在类型的多级划分，则nativeType的值应该为：fieldType.二级type.三级type...\n     * <p>\n     * 例如：业务表单存在关联浏览类型字段，其下客户具体划分为人力模块(hr)的部门类型(department)\n     * 则此时fieldType = RelateBrowser\n     * nativeType = RelateBrowser.hr.department\n     * <p>\n     * RelateBrowser为关联浏览字段本身的一级字段类型\n     */\n    private String nativeType;\n\n    /**\n     * 审批字段标签,必须封装\n     * 以审批的视角标识字段的特征\n     */\n    private List<WfFieldTypeTag> fieldTags;\n\n    /**\n     * 明细表id，非必须封装\n     * 如果字段属于明细字段，则必须封装\n     */\n    @JsonSerialize(using = ToStringSerializer.class)\n    private long detailTableId;\n\n    /**\n     * 字段数据库类型，非必须封装\n     * 字段在数据库表中使用的数据类型\n     */\n    private String fieldDbType;\n\n    /**\n     * 是否明细字段，必须封装\n     * 标识该当前字段师傅明细表字段\n     */\n    private boolean isDetail;\n\n\n    /**\n     * 是否删除，必须封装\n     */\n    private boolean isDelete;\n\n    /**\n     * 是否必填，非必须封装\n     * 标识字段是否必须填写\n     */\n    private boolean required;\n\n    /**\n     * 数据源，非必须封装\n     */\n    private String dataSource;\n\n    /**\n     * 数据源id，非必须封装\n     */\n    @JsonSerialize(using = ToStringSerializer.class)\n    private long dataSourceId;\n\n    /**\n     * 字段所属表单id，必须封装\n     * 标识当前字段属于哪个表单\n     */\n    @JsonSerialize(using = ToStringSerializer.class)\n    private long formId;\n\n    /**\n     * 是否复合类型字段，非必须封装\n     */\n    private boolean complex;\n\n    /**\n     * 子字段列表，非必须封装\n     */\n    private List<WfFormFieldEntity> subFields;\n\n    /**\n     * 字段布局明细，非必须封装\n     */\n    private String layoutDetail;\n\n    /**\n     * 字段所属明细表id，非必须封装\n     * 若当前字段为明细字段，则必须封装\n     */\n    private long sFormId;\n\n    /**\n     * 复杂类型字段id，非必须封装\n     */\n    private long complexId;\n\n    /**\n     * 字段所属明细表名称\n     */\n    private String subFormName;\n\n    /**\n     * 扩展属性，特殊字段通过该字段扩展\n     */\n    private Map<String, Object> otherParams;"
        }
      ]
    }
