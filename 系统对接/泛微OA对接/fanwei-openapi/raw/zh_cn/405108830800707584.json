          "text": "{\n    \"data\": [\n        {\n            \"id\": 1, // 权限项ID\n            \"menuCode\": \"参数传递的菜单编码\",\n            \"permissionSetCode\": \"参数传递的权限项编码\"\n            \"msg\": \"失败描述信息\"  // 仅失败时会返回\n        }\n    ],\n    \"message\": {\n        \"errcode\": \"0\",  // 0代表成功，-1代表失败\n        \"errmsg\": \"success\"  // 成功为success，失败为描述\n    }\n}"
