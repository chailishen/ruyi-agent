          "text": "标记已读\n\nflag=1 statue=0 代表标记已办\nflag=1 statue=1 代表强制撤回，删除消息。\nflag=1 statue=2 代表删除流程时撤回消息\nflag=1 statue=3 代表退回流程时待办转已办，消息不删除。\n根据消息id标记已读:\n\n{\n  \"operator\": {\n    \"employeeId\": \"5805818419368081366\",\n    \"tenantKey\": \"ty0tu018gk\"\n  },\n  \"msgIds\": [736098042587668481]\n}\n\n标记已处理\n\n{\n  \"operator\": {\n    \"employeeId\": \"5805818419368081366\",\n    \"tenantKey\": \"ty0tu018gk\"\n  },\n  \"msgIds\": [736098042587668481],\n  \"entityId\": \"1231321\",\n  \"flag\": 1\n}\n\n删除待办消息—> 流程强制撤回时\n{\n  \"operator\": {\n    \"employeeId\": \"5805818419368081366\",\n    \"tenantKey\": \"ty0tu018gk\"\n  },\n  \"msgIds\": [736098042587668481],\n  \"entityId\": \"1231321\",\n  \"flag\": 1,\n  \"statue\": 1\n}\n\n删除待办消息—> 删除流程时\n{\n  \"operator\": {\n    \"employeeId\": \"5805818419368081366\",\n    \"tenantKey\": \"ty0tu018gk\"\n  },\n  \"msgIds\": [736098042587668481],\n  \"entityId\": \"1231321\",\n  \"flag\": 1,\n  \"statue\": 2\n}\n退回流程时待办转已办，消息不删除\n{\n  \"operator\": {\n    \"employeeId\": \"5805818419368081366\",\n    \"tenantKey\": \"ty0tu018gk\"\n  },\n  \"msgIds\": [736098042587668481],\n  \"entityId\": \"1231321\",\n  \"flag\": 1,\n  \"statue\": 3\n}"
